# Runtime tuning only. There are NO credentials here.
#
# This service holds no LinkedIn session of its own: every request carries the
# caller's own li_at cookie, which is used for that one request and discarded.
# Nothing secret needs to be configured to run it.

# How long a fetched profile stays cached, in seconds.
# Longer means fewer calls to LinkedIn, which is the main protection
# against being rate limited.
CACHE_TTL_SECONDS=3600

# Maximum profiles held in the in-process cache.
CACHE_MAX_ENTRIES=512

# Per-request timeout when calling LinkedIn, in seconds.
UPSTREAM_TIMEOUT_SECONDS=20

LOG_LEVEL=INFO
